# Archivos generados por Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Variables privadas y credenciales
.env
.env.*
!.env.example

# Bases de datos locales y datos biométricos
/data/
*.db
*.sqlite
*.sqlite3

# Fotografías de referencia locales
/rostros/referencias/*
!/rostros/referencias/.gitkeep

# Fotografías utilizadas en pruebas
/rostros/pruebas/*
!/rostros/pruebas/.gitkeep

# Fotografías y archivos temporales
/temp/*
!/temp/.gitkeep

# Modelos descargados y caché de DeepFace
.deepface/
.cache/

# Configuraciones locales de IDE
.idea/
.vscode/

# Registros locales
*.log

# Scripts locales de migración y pruebas
/migrations/
/pruba_base.py

# Configuraciones locales de despliegue
.railway/
